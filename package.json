{
  "name": "project-operations-portal",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "predev": "pnpm --filter @pmt/shared build",
    "dev": "pnpm --parallel --filter @pmt/api --filter @pmt/web dev",
    "doctor": "node scripts/doctor.cjs",
    "build": "pnpm --filter @pmt/api build && pnpm --filter @pmt/web build",
    "typecheck": "pnpm -r typecheck",
    "pretypecheck": "pnpm --filter @pmt/shared build",
    "pretest": "pnpm --filter @pmt/shared build",
    "test": "vitest run",
    "test:api": "vitest run tests/api.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx --tsconfig apps/api/tsconfig.json packages/database/seed.ts",
    "jobs:dev": "pnpm --filter @pmt/api exec tsx src/jobs.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.48.0",
    "prettier": "^3.7.0",
    "typescript": "~5.9.3",
    "tsx": "^4.21.0",
    "vitest": "^3.2.4",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "@playwright/test": "^1.58.0",
    "prisma": "6.19.2",
    "@types/node": "^22.19.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "dotenv": "^17.2.3"
  }
}
