# Inject credentials via the deployment secret manager.
NODE_ENV=production
APP_ORIGIN=https://staging.operations.example.com
API_PORT=4000
API_INTERNAL_URL=http://api:4000
S3_REGION=ap-south-1
S3_BUCKET=fieldwork-staging-private
# Required secrets: DATABASE_URL, IDENTITY_MAIL_KEY, SMTP_HOST/SMTP_PORT/SMTP_FROM,
# S3_ENDPOINT/S3_PUBLIC_ENDPOINT and credentials or workload identity.
# Set MALWARE_SCAN_URL/TOKEN and OTEL_EXPORTER_OTLP_ENDPOINT.
