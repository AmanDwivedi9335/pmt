{
  "name": "@pmt/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "jobs": "node dist/jobs.js",
    "build": "pnpm --workspace-root db:generate && pnpm --filter @pmt/shared build && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.985.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@pmt/database": "workspace:*",
    "@pmt/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "helmet": "^8.1.0",
    "mongodb-connection-string-url": "^7.0.2",
    "nodemailer": "^7.0.12",
    "pdfkit": "0.20.2",
    "pino": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^7.0.5",
    "@types/pdfkit": "0.17.7"
  }
}
