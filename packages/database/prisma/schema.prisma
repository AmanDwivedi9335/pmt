generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  PLANNED
  ACTIVE
  ON_HOLD
  DELAYED
  COMPLETED
  CLOSED
  CANCELLED
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  APPROVED
  REJECTED
  REVERSED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum MovementKind {
  RECEIPT
  CONSUMPTION
  RETURN
  REVERSAL
  TRANSFER
  ADJUSTMENT
}

model User {
  id           String          @id @default(uuid()) @map("_id")
  email        String          @unique
  name         String
  passwordHash String
  createdAt    DateTime        @default(now())
  memberships  Membership[]
  sessions     Session[]
  tokens       IdentityToken[]
}

model Organization {
  id          String       @id @default(uuid()) @map("_id")
  name        String
  currency    String       @default("INR")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  teams       Team[]
  roles       Role[]
  projects    Project[]
  clients     Client[]
  materials   Material[]
  invitations Invitation[]
  audits      Audit[]
  outbox      Outbox[]
}

model Role {
  id           String       @id @default(uuid()) @map("_id")
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  name         String
  permissions  String[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([orgId, name])
  @@unique([id, orgId])
}

model Membership {
  id            String          @id @default(uuid()) @map("_id")
  orgId         String
  userId        String
  roleId        String
  organization  Organization    @relation(fields: [orgId], references: [id])
  user          User            @relation(fields: [userId], references: [id])
  role          Role            @relation(fields: [roleId], references: [id])
  projectAccess ProjectMember[]
  teams         TeamMember[]
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())

  @@unique([orgId, userId])
  @@unique([id, orgId])
}

model Team {
  id             String       @id @default(uuid()) @map("_id")
  orgId          String
  organization   Organization @relation(fields: [orgId], references: [id])
  name           String
  normalizedName String
  description    String       @default("")
  members        TeamMember[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([orgId, normalizedName])
  @@unique([id, orgId])
}

model TeamMember {
  id           String     @id @default(uuid()) @map("_id")
  orgId        String
  teamId       String
  membershipId String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([teamId, membershipId])
  @@index([membershipId, orgId])
}

model Session {
  id        String   @id @default(uuid()) @map("_id")
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  csrf      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model IdentityToken {
  id        String    @id @default(uuid()) @map("_id")
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

model Invitation {
  id           String       @id @default(uuid()) @map("_id")
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  email        String
  roleId       String
  role         Role         @relation(fields: [roleId], references: [id])
  tokenHash    String       @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([orgId, email])
}

model LoginAttempt {
  key      String   @id @map("_id")
  count    Int      @default(0)
  windowAt DateTime @default(now())
}

model Client {
  id           String       @id @default(uuid()) @map("_id")
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  name         String
  email        String?
  address      String?
  archivedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  projects     Project[]

  @@unique([id, orgId])
  @@index([orgId, name])
}

model Project {
  id             String          @id @default(uuid()) @map("_id")
  orgId          String
  organization   Organization    @relation(fields: [orgId], references: [id])
  clientId       String
  client         Client          @relation(fields: [clientId], references: [id])
  code           String
  name           String
  description    String          @default("")
  address        String          @default("")
  city           String
  state          String          @default("")
  country        String          @default("India")
  mapUrl         String?
  startDate      DateTime?
  targetDate     DateTime?
  actualDate     DateTime?
  manager        String          @default("")
  budget         String          @default("0")
  contractValue  String          @default("0")
  remarks        String          @default("")
  status         ProjectStatus   @default(DRAFT)
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        ProjectMember[]
  sites          Site[]
  contacts       Contact[]
  workOrders     WorkOrder[]
  movements      StockMovement[]
  installations  Installation[]
  invoices       Invoice[]
  payments       Payment[]
  imports        ImportBatch[]
  tasks          Task[]
  documents      Document[]
  purchaseOrders PurchaseOrder[]

  @@unique([orgId, code])
  @@unique([id, orgId])
  @@index([orgId, status, targetDate])
}

model ProjectMember {
  id           String     @id @default(uuid()) @map("_id")
  orgId        String
  projectId    String
  membershipId String
  project      Project    @relation(fields: [projectId], references: [id])
  membership   Membership @relation(fields: [membershipId], references: [id])

  @@unique([projectId, membershipId])
}

model Site {
  id        String   @id @default(uuid()) @map("_id")
  orgId     String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  address   String   @default("")
  createdAt DateTime @default(now())

  @@unique([id, projectId])
}

model Contact {
  id        String  @id @default(uuid()) @map("_id")
  orgId     String
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  name      String
  role      String
  email     String?
  phone     String?
}

model Material {
  id           String       @id @default(uuid()) @map("_id")
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  sku          String
  name         String
  category     String       @default("General")
  description  String       @default("")
  uom          String       @default("Nos")
  precision    Int          @default(0)
  standardRate String       @default("0")
  taxRate      String       @default("0")
  active       Boolean      @default(true)
  items        BoqItem[]

  @@unique([orgId, sku])
  @@unique([id, orgId])
}

model WorkOrder {
  id         String              @id @default(uuid()) @map("_id")
  orgId      String
  projectId  String
  project    Project             @relation(fields: [projectId], references: [id])
  number     String
  version    Int                 @default(1)
  approvedAt DateTime?
  createdAt  DateTime            @default(now())
  items      BoqItem[]
  revisions  WorkOrderRevision[]

  @@unique([projectId, number])
  @@unique([id, orgId])
}

model WorkOrderRevision {
  id          String    @id @default(uuid()) @map("_id")
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  version     Int
  snapshot    Json
  reason      String
  createdAt   DateTime  @default(now())

  @@unique([workOrderId, version])
}

model BoqItem {
  id               String           @id @default(uuid()) @map("_id")
  orgId            String
  workOrderId      String
  workOrder        WorkOrder        @relation(fields: [workOrderId], references: [id])
  materialId       String
  material         Material         @relation(fields: [materialId], references: [id])
  ordered          String
  supplyRate       String
  installationRate String
  taxRate          String           @default("0")
  version          Int              @default(1)
  openings         OpeningBalance[]
  movements        StockMovement[]
  installations    Installation[]
  invoiceLines     InvoiceLine[]
  purchaseLines    PurchaseLine[]

  @@unique([workOrderId, materialId])
  @@unique([id, orgId])
}

model Supplier {
  id        String          @id @default(uuid()) @map("_id")
  orgId     String
  name      String
  email     String?
  taxId     String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  orders    PurchaseOrder[]

  @@unique([id, orgId])
  @@index([orgId, name])
}

model PurchaseOrder {
  id         String         @id @default(uuid()) @map("_id")
  orgId      String
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id])
  supplierId String
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  number     String
  status     ApprovalStatus @default(DRAFT)
  version    Int            @default(1)
  createdBy  String
  approvedBy String?
  createdAt  DateTime       @default(now())
  lines      PurchaseLine[]

  @@unique([orgId, number])
  @@unique([id, orgId])
}

model PurchaseLine {
  id              String        @id @default(uuid()) @map("_id")
  orgId           String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  boqItemId       String
  boqItem         BoqItem       @relation(fields: [boqItemId], references: [id])
  quantity        String
  rate            String
  dispatches      Dispatch[]

  @@unique([id, orgId])
  @@unique([purchaseOrderId, boqItemId])
}

model Dispatch {
  id             String         @id @default(uuid()) @map("_id")
  orgId          String
  purchaseLineId String
  purchaseLine   PurchaseLine   @relation(fields: [purchaseLineId], references: [id])
  challan        String
  quantity       String
  dispatchedAt   DateTime       @default(now())
  receipts       GoodsReceipt[]

  @@unique([orgId, challan, purchaseLineId])
  @@unique([id, orgId])
}

model GoodsReceipt {
  id         String   @id @default(uuid()) @map("_id")
  orgId      String
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id])
  reference  String
  accepted   String
  damaged    String
  rejected   String
  createdAt  DateTime @default(now())

  @@unique([orgId, dispatchId, reference])
}

model ImportBatch {
  id         String           @id @default(uuid()) @map("_id")
  orgId      String
  projectId  String
  project    Project          @relation(fields: [projectId], references: [id])
  sourceHash String
  sourceName String
  mapping    Json
  source     Json
  asOf       DateTime
  createdAt  DateTime         @default(now())
  reversedAt DateTime?
  openings   OpeningBalance[]

  @@unique([orgId, sourceHash])
}

model OpeningBalance {
  id                 String      @id @default(uuid()) @map("_id")
  orgId              String
  batchId            String
  batch              ImportBatch @relation(fields: [batchId], references: [id])
  boqItemId          String
  boqItem            BoqItem     @relation(fields: [boqItemId], references: [id])
  supplied           String
  installed          String
  supplyBilled       String
  installationBilled String
  sourceRow          Int

  @@unique([batchId, boqItemId])
}

model StockMovement {
  id          String       @id @default(uuid()) @map("_id")
  orgId       String
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  boqItemId   String
  boqItem     BoqItem      @relation(fields: [boqItemId], references: [id])
  kind        MovementKind
  quantity    String
  reference   String
  reason      String
  actorId     String
  effectiveAt DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([orgId, projectId, boqItemId, effectiveAt])
}

model Installation {
  id         String         @id @default(uuid()) @map("_id")
  orgId      String
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id])
  boqItemId  String
  boqItem    BoqItem        @relation(fields: [boqItemId], references: [id])
  quantity   String
  area       String
  reportDate DateTime
  notes      String         @default("")
  status     ApprovalStatus @default(DRAFT)
  reason     String?
  createdBy  String
  approvedBy String?
  approvedAt DateTime?
  version    Int            @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([orgId, projectId, status])
}

model Invoice {
  id                 String              @id @default(uuid()) @map("_id")
  orgId              String
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id])
  number             String
  kind               String
  status             InvoiceStatus       @default(DRAFT)
  currency           String
  subtotal           String
  tax                String
  retention          String              @default("0")
  total              String
  dueDate            DateTime
  issuedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime            @default(now())
  lines              InvoiceLine[]
  allocations        PaymentAllocation[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, projectId, status, dueDate])
}

model InvoiceLine {
  id        String  @id @default(uuid()) @map("_id")
  orgId     String
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  boqItemId String
  boqItem   BoqItem @relation(fields: [boqItemId], references: [id])
  quantity  String
  rate      String
  taxRate   String
  amount    String
}

model Payment {
  id          String              @id @default(uuid()) @map("_id")
  orgId       String
  projectId   String
  project     Project             @relation(fields: [projectId], references: [id])
  amount      String
  reference   String
  receivedAt  DateTime
  createdAt   DateTime            @default(now())
  allocations PaymentAllocation[]

  @@unique([id, orgId])
  @@unique([orgId, reference])
}

model PaymentAllocation {
  id        String   @id @default(uuid()) @map("_id")
  orgId     String
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    String
  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
}

model Task {
  id          String    @id @default(uuid()) @map("_id")
  orgId       String
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  title       String
  description String    @default("")
  assigneeId  String?
  priority    String    @default("MEDIUM")
  status      String    @default("TODO")
  dueDate     DateTime?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId, projectId, status, dueDate])
}

model Document {
  id        String   @id @default(uuid()) @map("_id")
  orgId     String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  objectKey String   @unique
  mimeType  String
  size      Int
  status    String   @default("QUARANTINED")
  createdBy String
  createdAt DateTime @default(now())

  @@index([orgId, projectId])
}

model Idempotency {
  id        String   @id @default(uuid()) @map("_id")
  orgId     String
  key       String
  hash      String
  result    Json
  createdAt DateTime @default(now())

  @@unique([orgId, key])
}

model Audit {
  id           String        @id @default(uuid()) @map("_id")
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])
  actorId      String?
  action       String
  resourceId   String?
  detail       Json
  createdAt    DateTime      @default(now())

  @@index([orgId, createdAt])
}

model Outbox {
  projectId    String?
  id           String        @id @default(uuid()) @map("_id")
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])
  kind         String
  payload      Json
  dedupeKey    String        @unique
  attempts     Int           @default(0)
  availableAt  DateTime      @default(now())
  processedAt  DateTime?
  lastError    String?
  leaseToken   String?
  leaseUntil   DateTime?

  @@index([processedAt, availableAt])
  @@index([orgId, kind, projectId, availableAt])
}

model WriteLock {
  id       String @id @map("_id")
  revision String
}
