generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  PLANNED
  ACTIVE
  ON_HOLD
  DELAYED
  COMPLETED
  CLOSED
  CANCELLED
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  APPROVED
  REJECTED
  REVERSED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum MovementKind {
  RECEIPT
  CONSUMPTION
  RETURN
  REVERSAL
  TRANSFER
  ADJUSTMENT
}

model User {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique
  name         String
  passwordHash String
  createdAt    DateTime        @default(now())
  memberships  Membership[]
  sessions     Session[]
  tokens       IdentityToken[]
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  currency    String       @default("INR")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  teams       Team[]
  roles       Role[]
  projects    Project[]
  clients     Client[]
  materials   Material[]
  invitations Invitation[]
  audits      Audit[]
  outbox      Outbox[]
}

model Role {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id])
  name         String
  permissions  String[]
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([orgId, name])
  @@unique([id, orgId])
}

model Membership {
  id            String          @id @default(uuid()) @db.Uuid
  orgId         String          @db.Uuid
  userId        String          @db.Uuid
  roleId        String          @db.Uuid
  organization  Organization    @relation(fields: [orgId], references: [id])
  user          User            @relation(fields: [userId], references: [id])
  role          Role            @relation(fields: [roleId, orgId], references: [id, orgId])
  projectAccess ProjectMember[]
  teams         TeamMember[]
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())

  @@unique([orgId, userId])
  @@unique([id, orgId])
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @db.Uuid
  organization   Organization @relation(fields: [orgId], references: [id])
  name           String
  normalizedName String
  description    String       @default("")
  members        TeamMember[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([orgId, normalizedName])
  @@unique([id, orgId])
}

model TeamMember {
  orgId        String     @db.Uuid
  teamId       String     @db.Uuid
  membershipId String     @db.Uuid
  team         Team       @relation(fields: [teamId, orgId], references: [id, orgId], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId, orgId], references: [id, orgId])
  createdAt    DateTime   @default(now())

  @@id([teamId, membershipId])
  @@index([membershipId, orgId])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  csrf      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model IdentityToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

model Invitation {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id])
  email        String
  roleId       String       @db.Uuid
  role         Role         @relation(fields: [roleId, orgId], references: [id, orgId])
  tokenHash    String       @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime     @default(now())

  @@index([orgId, email])
}

model LoginAttempt {
  key      String   @id
  count    Int      @default(0)
  windowAt DateTime @default(now())
}

model Client {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id])
  name         String
  email        String?
  address      String?
  archivedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  projects     Project[]

  @@unique([id, orgId])
  @@index([orgId, name])
}

model Project {
  id             String          @id @default(uuid()) @db.Uuid
  orgId          String          @db.Uuid
  organization   Organization    @relation(fields: [orgId], references: [id])
  clientId       String          @db.Uuid
  client         Client          @relation(fields: [clientId, orgId], references: [id, orgId])
  code           String
  name           String
  description    String          @default("")
  address        String          @default("")
  city           String
  state          String          @default("")
  country        String          @default("India")
  mapUrl         String?
  startDate      DateTime?       @db.Date
  targetDate     DateTime?       @db.Date
  actualDate     DateTime?       @db.Date
  manager        String          @default("")
  budget         Decimal         @default(0) @db.Decimal(20, 2)
  contractValue  Decimal         @default(0) @db.Decimal(20, 2)
  remarks        String          @default("")
  status         ProjectStatus   @default(DRAFT)
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        ProjectMember[]
  sites          Site[]
  contacts       Contact[]
  workOrders     WorkOrder[]
  movements      StockMovement[]
  installations  Installation[]
  invoices       Invoice[]
  payments       Payment[]
  imports        ImportBatch[]
  tasks          Task[]
  documents      Document[]
  purchaseOrders PurchaseOrder[]

  @@unique([orgId, code])
  @@unique([id, orgId])
  @@index([orgId, status, targetDate])
}

model ProjectMember {
  orgId        String     @db.Uuid
  projectId    String     @db.Uuid
  membershipId String     @db.Uuid
  project      Project    @relation(fields: [projectId, orgId], references: [id, orgId])
  membership   Membership @relation(fields: [membershipId, orgId], references: [id, orgId])

  @@id([projectId, membershipId])
}

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId, orgId], references: [id, orgId])
  name      String
  address   String   @default("")
  createdAt DateTime @default(now())

  @@unique([id, projectId])
}

model Contact {
  id        String  @id @default(uuid()) @db.Uuid
  orgId     String  @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId, orgId], references: [id, orgId])
  name      String
  role      String
  email     String?
  phone     String?
}

model Material {
  id           String       @id @default(uuid()) @db.Uuid
  orgId        String       @db.Uuid
  organization Organization @relation(fields: [orgId], references: [id])
  sku          String
  name         String
  category     String       @default("General")
  description  String       @default("")
  uom          String       @default("Nos")
  precision    Int          @default(0)
  standardRate Decimal      @default(0) @db.Decimal(20, 2)
  taxRate      Decimal      @default(0) @db.Decimal(5, 2)
  active       Boolean      @default(true)
  items        BoqItem[]

  @@unique([orgId, sku])
  @@unique([id, orgId])
}

model WorkOrder {
  id         String              @id @default(uuid()) @db.Uuid
  orgId      String              @db.Uuid
  projectId  String              @db.Uuid
  project    Project             @relation(fields: [projectId, orgId], references: [id, orgId])
  number     String
  version    Int                 @default(1)
  approvedAt DateTime?
  createdAt  DateTime            @default(now())
  items      BoqItem[]
  revisions  WorkOrderRevision[]

  @@unique([projectId, number])
  @@unique([id, orgId])
}

model WorkOrderRevision {
  id          String    @id @default(uuid()) @db.Uuid
  workOrderId String    @db.Uuid
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  version     Int
  snapshot    Json
  reason      String
  createdAt   DateTime  @default(now())

  @@unique([workOrderId, version])
}

model BoqItem {
  id               String           @id @default(uuid()) @db.Uuid
  orgId            String           @db.Uuid
  workOrderId      String           @db.Uuid
  workOrder        WorkOrder        @relation(fields: [workOrderId, orgId], references: [id, orgId])
  materialId       String           @db.Uuid
  material         Material         @relation(fields: [materialId, orgId], references: [id, orgId])
  ordered          Decimal          @db.Decimal(20, 4)
  supplyRate       Decimal          @db.Decimal(20, 2)
  installationRate Decimal          @db.Decimal(20, 2)
  taxRate          Decimal          @default(0) @db.Decimal(5, 2)
  version          Int              @default(1)
  openings         OpeningBalance[]
  movements        StockMovement[]
  installations    Installation[]
  invoiceLines     InvoiceLine[]
  purchaseLines    PurchaseLine[]

  @@unique([workOrderId, materialId])
  @@unique([id, orgId])
}

model Supplier {
  id        String          @id @default(uuid()) @db.Uuid
  orgId     String          @db.Uuid
  name      String
  email     String?
  taxId     String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  orders    PurchaseOrder[]

  @@unique([id, orgId])
  @@index([orgId, name])
}

model PurchaseOrder {
  id         String         @id @default(uuid()) @db.Uuid
  orgId      String         @db.Uuid
  projectId  String         @db.Uuid
  project    Project        @relation(fields: [projectId, orgId], references: [id, orgId])
  supplierId String         @db.Uuid
  supplier   Supplier       @relation(fields: [supplierId, orgId], references: [id, orgId])
  number     String
  status     ApprovalStatus @default(DRAFT)
  version    Int            @default(1)
  createdBy  String         @db.Uuid
  approvedBy String?        @db.Uuid
  createdAt  DateTime       @default(now())
  lines      PurchaseLine[]

  @@unique([orgId, number])
  @@unique([id, orgId])
}

model PurchaseLine {
  id              String        @id @default(uuid()) @db.Uuid
  orgId           String        @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId, orgId], references: [id, orgId])
  boqItemId       String        @db.Uuid
  boqItem         BoqItem       @relation(fields: [boqItemId, orgId], references: [id, orgId])
  quantity        Decimal       @db.Decimal(20, 4)
  rate            Decimal       @db.Decimal(20, 2)
  dispatches      Dispatch[]

  @@unique([id, orgId])
  @@unique([purchaseOrderId, boqItemId])
}

model Dispatch {
  id             String         @id @default(uuid()) @db.Uuid
  orgId          String         @db.Uuid
  purchaseLineId String         @db.Uuid
  purchaseLine   PurchaseLine   @relation(fields: [purchaseLineId, orgId], references: [id, orgId])
  challan        String
  quantity       Decimal        @db.Decimal(20, 4)
  dispatchedAt   DateTime       @default(now())
  receipts       GoodsReceipt[]

  @@unique([orgId, challan, purchaseLineId])
  @@unique([id, orgId])
}

model GoodsReceipt {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  dispatchId String   @db.Uuid
  dispatch   Dispatch @relation(fields: [dispatchId, orgId], references: [id, orgId])
  reference  String
  accepted   Decimal  @db.Decimal(20, 4)
  damaged    Decimal  @db.Decimal(20, 4)
  rejected   Decimal  @db.Decimal(20, 4)
  createdAt  DateTime @default(now())

  @@unique([orgId, dispatchId, reference])
}

model ImportBatch {
  id         String           @id @default(uuid()) @db.Uuid
  orgId      String           @db.Uuid
  projectId  String           @db.Uuid
  project    Project          @relation(fields: [projectId, orgId], references: [id, orgId])
  sourceHash String
  sourceName String
  mapping    Json
  source     Json
  asOf       DateTime         @db.Date
  createdAt  DateTime         @default(now())
  reversedAt DateTime?
  openings   OpeningBalance[]

  @@unique([orgId, sourceHash])
}

model OpeningBalance {
  id                 String      @id @default(uuid()) @db.Uuid
  orgId              String      @db.Uuid
  batchId            String      @db.Uuid
  batch              ImportBatch @relation(fields: [batchId], references: [id])
  boqItemId          String      @db.Uuid
  boqItem            BoqItem     @relation(fields: [boqItemId, orgId], references: [id, orgId])
  supplied           Decimal     @db.Decimal(20, 4)
  installed          Decimal     @db.Decimal(20, 4)
  supplyBilled       Decimal     @db.Decimal(20, 4)
  installationBilled Decimal     @db.Decimal(20, 4)
  sourceRow          Int

  @@unique([batchId, boqItemId])
}

model StockMovement {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @db.Uuid
  projectId   String       @db.Uuid
  project     Project      @relation(fields: [projectId, orgId], references: [id, orgId])
  boqItemId   String       @db.Uuid
  boqItem     BoqItem      @relation(fields: [boqItemId, orgId], references: [id, orgId])
  kind        MovementKind
  quantity    Decimal      @db.Decimal(20, 4)
  reference   String
  reason      String
  actorId     String       @db.Uuid
  effectiveAt DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([orgId, projectId, boqItemId, effectiveAt])
}

model Installation {
  id         String         @id @default(uuid()) @db.Uuid
  orgId      String         @db.Uuid
  projectId  String         @db.Uuid
  project    Project        @relation(fields: [projectId, orgId], references: [id, orgId])
  boqItemId  String         @db.Uuid
  boqItem    BoqItem        @relation(fields: [boqItemId, orgId], references: [id, orgId])
  quantity   Decimal        @db.Decimal(20, 4)
  area       String
  reportDate DateTime       @db.Date
  notes      String         @default("")
  status     ApprovalStatus @default(DRAFT)
  reason     String?
  createdBy  String         @db.Uuid
  approvedBy String?        @db.Uuid
  approvedAt DateTime?
  version    Int            @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([orgId, projectId, status])
}

model Invoice {
  id                 String              @id @default(uuid()) @db.Uuid
  orgId              String              @db.Uuid
  projectId          String              @db.Uuid
  project            Project             @relation(fields: [projectId, orgId], references: [id, orgId])
  number             String
  kind               String
  status             InvoiceStatus       @default(DRAFT)
  currency           String
  subtotal           Decimal             @db.Decimal(20, 2)
  tax                Decimal             @db.Decimal(20, 2)
  retention          Decimal             @default(0) @db.Decimal(20, 2)
  total              Decimal             @db.Decimal(20, 2)
  dueDate            DateTime            @db.Date
  issuedAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime            @default(now())
  lines              InvoiceLine[]
  allocations        PaymentAllocation[]

  @@unique([orgId, number])
  @@unique([id, orgId])
  @@index([orgId, projectId, status, dueDate])
}

model InvoiceLine {
  id        String  @id @default(uuid()) @db.Uuid
  orgId     String  @db.Uuid
  invoiceId String  @db.Uuid
  invoice   Invoice @relation(fields: [invoiceId, orgId], references: [id, orgId])
  boqItemId String  @db.Uuid
  boqItem   BoqItem @relation(fields: [boqItemId, orgId], references: [id, orgId])
  quantity  Decimal @db.Decimal(20, 4)
  rate      Decimal @db.Decimal(20, 2)
  taxRate   Decimal @db.Decimal(5, 2)
  amount    Decimal @db.Decimal(20, 2)
}

model Payment {
  id          String              @id @default(uuid()) @db.Uuid
  orgId       String              @db.Uuid
  projectId   String              @db.Uuid
  project     Project             @relation(fields: [projectId, orgId], references: [id, orgId])
  amount      Decimal             @db.Decimal(20, 2)
  reference   String
  receivedAt  DateTime            @db.Date
  createdAt   DateTime            @default(now())
  allocations PaymentAllocation[]

  @@unique([id, orgId])
  @@unique([orgId, reference])
}

model PaymentAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  paymentId String   @db.Uuid
  payment   Payment  @relation(fields: [paymentId, orgId], references: [id, orgId])
  invoiceId String   @db.Uuid
  invoice   Invoice  @relation(fields: [invoiceId, orgId], references: [id, orgId])
  amount    Decimal  @db.Decimal(20, 2)
  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @db.Uuid
  projectId   String    @db.Uuid
  project     Project   @relation(fields: [projectId, orgId], references: [id, orgId])
  title       String
  description String    @default("")
  assigneeId  String?   @db.Uuid
  priority    String    @default("MEDIUM")
  status      String    @default("TODO")
  dueDate     DateTime? @db.Date
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orgId, projectId, status, dueDate])
}

model Document {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId, orgId], references: [id, orgId])
  name      String
  objectKey String   @unique
  mimeType  String
  size      Int
  status    String   @default("QUARANTINED")
  createdBy String   @db.Uuid
  createdAt DateTime @default(now())

  @@index([orgId, projectId])
}

model Idempotency {
  orgId     String   @db.Uuid
  key       String
  hash      String
  result    Json
  createdAt DateTime @default(now())

  @@id([orgId, key])
}

model Audit {
  id           String        @id @default(uuid()) @db.Uuid
  orgId        String?       @db.Uuid
  organization Organization? @relation(fields: [orgId], references: [id])
  actorId      String?       @db.Uuid
  action       String
  resourceId   String?
  detail       Json
  createdAt    DateTime      @default(now())

  @@index([orgId, createdAt])
}

model Outbox {
  id           String        @id @default(uuid()) @db.Uuid
  orgId        String?       @db.Uuid
  organization Organization? @relation(fields: [orgId], references: [id])
  kind         String
  payload      Json
  dedupeKey    String        @unique
  attempts     Int           @default(0)
  availableAt  DateTime      @default(now())
  processedAt  DateTime?
  lastError    String?

  @@index([processedAt, availableAt])
}
